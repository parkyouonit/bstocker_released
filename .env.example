# Verified SPCXB/USDT PancakeSwap V3 pool on BNB Chain.
VITE_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
VITE_POOL_ADDRESS=0x977DaFFC095b33872E2741c19568925015C35b4d
VITE_TOKEN0_ADDRESS=0x55d398326f99059fF775485246999027B3197955
VITE_TOKEN1_ADDRESS=0xbe9d156892e55e7154bcd3cb0fea677f9d3103e1
VITE_TOKEN0_SYMBOL=USDT
VITE_TOKEN1_SYMBOL=SPCXB
VITE_TOKEN0_DECIMALS=18
VITE_TOKEN1_DECIMALS=18
VITE_POOL_FEE=2500
# Official PancakeSwap V3 BNB Chain periphery contracts. These are also the app defaults.
VITE_NPM_ADDRESS=0x46A15B0b27311cedF172AB29E4f4766fbE7F4364
VITE_SMART_ROUTER_ADDRESS=0x1b81D678ffb9C0263b24A97847620C99d213eB14
VITE_QUOTER_V2_ADDRESS=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
VITE_PANCAKE_V3_FACTORY_ADDRESS=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
VITE_PANCAKE_V3_MASTER_CHEF_ADDRESS=0x556B9306565093C855AEA9AE92A594704c2Cd59e
VITE_CAKE_ADDRESS=0x0E09FaBB73Bd3Ade0a17ECC321fD13a19e81cE82
VITE_MERKL_DISTRIBUTOR_ADDRESS=0x3Ef3D8bA38EBe18DB133cEc108f4D14CE00Dd9Ae
# Dynamic directory searches up to this many GeckoTerminal pages (1-5) and caches results for 5 minutes.
POOL_DIRECTORY_SEARCH_PAGES=3
VITE_API_BASE_URL=
VITE_BRIDGE_METADATA_URL=https://stargate-bridge-params.vercel.app/oft-checker/data/oft-snapshot.json
VITE_BRIDGE_ACTIVITY_URL=https://stargate-bridge-params.vercel.app/oft-checker/data/adapter-activity-index.json
# Browser calls the same-origin backend proxy. Keep API credentials server-side.
VITE_BRIDGE_API_URL=/api/bridge
# Legacy Stargate API is public and used as the no-key fallback.
STARGATE_API_URL=https://stargate.finance/api/v1
# Latest official LayerZero Value Transfer API; quotes/status use it when a key is configured.
LZ_VALUE_TRANSFER_API_URL=https://transfer.layerzero-api.com/v1
LZ_VALUE_TRANSFER_API_KEY=
BRIDGE_API_MODE=auto
# Set true only when the operator accepts real approve/swap/mint transactions.
VITE_ENABLE_MAINNET_WRITES=false
# Independently gates Pancake Farm and Merkl claim writes. Both flags must be true.
VITE_ENABLE_REWARD_WRITES=false
# Bridge write actions are separately gated. Code-level allowlisting still limits writes
# to the on-chain verified DOS BNB Chain <-> Ethereum OFT route.
VITE_ENABLE_MAINNET_BRIDGE=false

# Robinhood Chain SPCX/USDG 5-tick strategy. All three server gates and the
# browser build gate must be enabled. Bind the public server to one owner so
# another visitor cannot consume the PC keeper's gas.
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com
ROBINHOOD_KEEPER_MODE=shadow
ROBINHOOD_LIVE_AUTOMATION_ALLOWED=false
ROBINHOOD_AUTOMATION_OWNER=
ROBINHOOD_KEEPER_POLL_MS=5000
VITE_ENABLE_ROBINHOOD_STRATEGY_WRITES=false
# Allows only the verified pool's permissionless observation-buffer expansion. No token approval or transfer.
VITE_ENABLE_ROBINHOOD_ORACLE_PREP=false
